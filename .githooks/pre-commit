#!/usr/bin/env bash
# The fork's checks before every commit: lint, the short tests, and the live-only
# oracle scenario as its own invocation (it needs the process's one synctest
# bubble, so `just test` skips it). The heavy tiers (test-long, oracle-sweep, the
# mutation gate) run by hand before a tag: the mutation driver needs a clean tree.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
export GOTOOLCHAIN=${GOTOOLCHAIN:-go1.27.3}

# check what's being committed, not unstaged or untracked files beside it
if ! git diff --quiet || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
    git stash push --keep-index --include-untracked --quiet --message "pre-commit"
    stashed=1
fi
log=""
trap 'rm -f "${log:-}"; if [[ -n ${stashed:-} ]]; then git stash pop --quiet; fi' EXIT

step() { printf '\npre-commit: %s\n' "$*"; }

step "just lint"
just lint

step "just test"
just test

step "the live-only oracle scenario, alone"
log="$(mktemp)"
go test ./internal/oracle -run '^TestOracle_LiveOnlyRetention$' -count=1 -v 2>&1 | tee "$log"
if grep -q -- '--- SKIP: TestOracle_LiveOnlyRetention' "$log" || ! grep -q -- '--- PASS: TestOracle_LiveOnlyRetention' "$log"; then
    echo "pre-commit: TestOracle_LiveOnlyRetention did not pass (skipped or missing)" >&2
    exit 1
fi
